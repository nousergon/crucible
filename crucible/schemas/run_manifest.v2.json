{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "\u00a79.2 class 4: one artifact a job read or wrote, content-hashed.\n\nA store key rather than a URI, so the same manifest is portable between\nthe S3 and local-dir store backends; `schema_version` is required\nbecause an un-versioned cross-module artifact is the M0 contract\nviolation.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "key",
        "sha256",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AttemptRow": {
      "additionalProperties": false,
      "description": "\u00a711 risk 2: one attempt this run made, including the declared\ntransient-class retry. A run that executed once records one attempt, so a\nretried run cannot be mistaken for a clean first-attempt run.",
      "properties": {
        "n": {
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "initial",
            "spot_interruption",
            "provider_5xx",
            "provider_timeout",
            "s3_throttling"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "n",
        "reason"
      ],
      "title": "AttemptRow",
      "type": "object"
    },
    "LlmCallRow": {
      "additionalProperties": false,
      "description": "\u00a79.2 class 2: one logical LLM call.\n\n`model_requested`/`model_served` are separate because a routed call that\nsilently served a different model is the failure this field exists to\nmake visible (principle 8: never a provider model id at the call site,\nalways a capability class or registry group). `route_degraded` and\n`fallback_used` are both required booleans and are separate facts \u2014\nresolve-time versus call-time \u2014 because on the router-edge route the\nfallback chain is walked by the proxy AFTER resolution, so a route can\nresolve healthy while the call is actually served by a fallback\n(`alpha-engine-config-I9969`, `I10006`).",
      "properties": {
        "cache_read": {
          "minimum": 0,
          "title": "Cache Read",
          "type": "integer"
        },
        "cache_write": {
          "minimum": 0,
          "title": "Cache Write",
          "type": "integer"
        },
        "callsite_id": {
          "minLength": 1,
          "title": "Callsite Id",
          "type": "string"
        },
        "fallback_used": {
          "title": "Fallback Used",
          "type": "boolean"
        },
        "model_requested": {
          "minLength": 1,
          "title": "Model Requested",
          "type": "string"
        },
        "model_served": {
          "minLength": 1,
          "title": "Model Served",
          "type": "string"
        },
        "route_degraded": {
          "title": "Route Degraded",
          "type": "boolean"
        },
        "served_deployment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Served Deployment"
        },
        "tokens_in": {
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "usd": {
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        }
      },
      "required": [
        "callsite_id",
        "model_requested",
        "model_served",
        "route_degraded",
        "fallback_used",
        "served_deployment",
        "tokens_in",
        "tokens_out",
        "cache_read",
        "cache_write",
        "usd"
      ],
      "title": "LlmCallRow",
      "type": "object"
    },
    "MetricRecordRow": {
      "additionalProperties": true,
      "description": "\u00a79.2 class 5. `MetricRecord`-shaped (`krepis.metrics.MetricRecord`),\nopen on extra fields for forward compatibility with a newer producer, but\nstrict about the two that make a number readable.\n\nDeliberately its OWN model rather than `krepis.metrics.MetricRecord`\nsubclassed \u2014 see this module's docstring: crucible's producers write\n`metric_type` values (`operational`, `coverage`, `drift`, ...) outside\n`krepis.metrics.MetricTypeLiteral`, which is scoped to the System Report\nCard v2. Reusing that model directly would have silently rejected them.",
      "properties": {
        "horizon_trading_days": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon Trading Days"
        },
        "last_updated_utc": {
          "description": "RFC 3339, UTC, `Z` suffix. A local-time timestamp in an artifact keyed by trading day is a date bug waiting to happen.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "title": "Last Updated Utc",
          "type": "string"
        },
        "metric_type": {
          "minLength": 1,
          "title": "Metric Type",
          "type": "string"
        },
        "module": {
          "minLength": 1,
          "title": "Module",
          "type": "string"
        },
        "n_floor": {
          "minimum": 0,
          "title": "N Floor",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "GREEN",
            "WATCH",
            "RED",
            "N/A-NOT-IMPL",
            "N/A-NOT-RUN",
            "N/A-LOW-N",
            "N/A-MISSING-INPUT",
            "OK",
            "FAIL",
            "BREACH",
            "unservable",
            "bootstrap",
            "unmeasurable",
            "measured",
            "decided",
            "held",
            "UNREPORTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_reason": {
          "minLength": 1,
          "title": "Status Reason",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "module",
        "metric_type",
        "n_floor",
        "status",
        "status_reason",
        "source_path",
        "last_updated_utc"
      ],
      "title": "MetricRecordRow",
      "type": "object"
    },
    "RejectedRow": {
      "additionalProperties": false,
      "description": "Rejections WITH REASON, never a bare count \u2014 a count with no reason\ncannot be acted on, and is how 901 of 903 tickers silently failed a\nliquidity gate for months.",
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "count"
      ],
      "title": "RejectedRow",
      "type": "object"
    },
    "ResourceRow": {
      "additionalProperties": false,
      "description": "\u00a79.2 class 3. Present on every manifest including laptop runs, where\n`spot` is false and `instance_type` is `local`.",
      "properties": {
        "disk_free_mb": {
          "minimum": 0,
          "title": "Disk Free Mb",
          "type": "number"
        },
        "escalated_to_on_demand": {
          "title": "Escalated To On Demand",
          "type": "boolean"
        },
        "instance_type": {
          "minLength": 1,
          "title": "Instance Type",
          "type": "string"
        },
        "interruptions": {
          "minimum": 0,
          "title": "Interruptions",
          "type": "integer"
        },
        "mem_peak_mb": {
          "minimum": 0,
          "title": "Mem Peak Mb",
          "type": "number"
        },
        "spot": {
          "title": "Spot",
          "type": "boolean"
        }
      },
      "required": [
        "instance_type",
        "spot",
        "escalated_to_on_demand",
        "interruptions",
        "mem_peak_mb",
        "disk_free_mb"
      ],
      "title": "ResourceRow",
      "type": "object"
    }
  },
  "$id": "https://github.com/nousergon/crucible/schemas/run_manifest.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The record every job writes at runs/{job}/{trading_day}/run.json. Generated from crucible.models.RunManifestV2; v1 declared no live/replay field and stays frozen at crucible/schemas/run_manifest.v1.json. The status<->reason cross-field rule is enforced by the model's `_status_and_reason_agree`, not restated here as an `allOf` -- see crucible/models.py's module docstring.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptRow"
      },
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "calendar_date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Calendar Date",
      "type": "string"
    },
    "code_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Code Sha",
      "type": "string"
    },
    "cost_usd": {
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "discriminator": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discriminator"
    },
    "finished": {
      "description": "RFC 3339, UTC, `Z` suffix. A local-time timestamp in an artifact keyed by trading day is a date bug waiting to happen.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "title": "Finished",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "job": {
      "enum": [
        "data.daily",
        "data.weekly",
        "data.heal",
        "experiment.new",
        "experiment.run",
        "experiment.grade",
        "promote",
        "report",
        "explain",
        "migrate.history",
        "release.pin",
        "release.lock",
        "smoke",
        "alerts.sweep",
        "heartbeat",
        "drift",
        "console",
        "board",
        "deploy",
        "weekly",
        "gate",
        "report.morning"
      ],
      "title": "Job",
      "type": "string"
    },
    "llm_calls": {
      "items": {
        "$ref": "#/$defs/LlmCallRow"
      },
      "title": "Llm Calls",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricRecordRow"
      },
      "title": "Metrics",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Outputs",
      "type": "array"
    },
    "reason": {
      "maxLength": 2000,
      "title": "Reason",
      "type": "string"
    },
    "release_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Release Sha",
      "type": "string"
    },
    "resource": {
      "$ref": "#/$defs/ResourceRow"
    },
    "rows_in": {
      "minimum": 0,
      "title": "Rows In",
      "type": "integer"
    },
    "rows_out": {
      "minimum": 0,
      "title": "Rows Out",
      "type": "integer"
    },
    "rows_rejected": {
      "items": {
        "$ref": "#/$defs/RejectedRow"
      },
      "title": "Rows Rejected",
      "type": "array"
    },
    "run_id": {
      "description": "ULID: lexically sortable by creation time. The correlation identity (\u00a79.2), on every log line, alert, cost row and S3 object's metadata for this run.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_mode": {
      "enum": [
        "live",
        "replay"
      ],
      "title": "Run Mode",
      "type": "string"
    },
    "schema_version": {
      "const": "run_manifest.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "started": {
      "description": "RFC 3339, UTC, `Z` suffix. A local-time timestamp in an artifact keyed by trading day is a date bug waiting to happen.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "title": "Started",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "trading_day": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Trading Day",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "job",
    "run_mode",
    "trading_day",
    "calendar_date",
    "status",
    "reason",
    "started",
    "finished",
    "code_sha",
    "release_sha",
    "seed",
    "inputs",
    "outputs",
    "rows_in",
    "rows_out",
    "rows_rejected",
    "cost_usd",
    "llm_calls",
    "resource",
    "metrics",
    "attempts"
  ],
  "title": "Crucible run manifest, v2",
  "type": "object"
}
